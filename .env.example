# Leave empty when the frontend and API are deployed together on Vercel.
NEXT_PUBLIC_API_BASE_URL=

# Optional: set only to a separate HTTPS backend implementing the routes in README.md.
MEDIA_BACKEND_URL=

# Per-process controls; defaults are intentionally conservative.
MEDIA_INFO_CACHE_TTL_MS=300000
MEDIA_MAX_CONCURRENT_EXTRACTIONS=2
MEDIA_MAX_CONCURRENT_DOWNLOADS=2
MEDIA_REQUEST_TIMEOUT_MS=30000
MEDIA_JOB_TTL_MS=900000

# Optional compatibility alias for MEDIA_BACKEND_URL.
# EXTERNAL_MEDIA_BACKEND_URL=
